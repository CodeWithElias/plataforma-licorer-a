# Configuración de Keycloak. Copiar a .env y poner valores propios. La usa en Docker el servicio keycloak (env_file).
# Los secretos de los clientes NO van aquí: Keycloak los lee del .env de quien los usa
# (KEYCLOAK_ADMIN_CLIENT_SECRET de ms-gestion/.env y N8N_CLIENT_SECRET de n8n/.env).

# Base de datos: Supabase (Project Settings → Connect → Session pooler, puerto 5432)
KC_DB_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
KC_DB_USERNAME=postgres.referencia-del-proyecto
KC_DB_PASSWORD=cambia-esta-clave
# Conexiones simultáneas a la base (el pooler gratuito de Supabase admite pocas)
KC_DB_POOL_INITIAL_SIZE=1
KC_DB_POOL_MIN_SIZE=1
KC_DB_POOL_MAX_SIZE=5

# Consola de administración (http://localhost/auth/admin)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave
