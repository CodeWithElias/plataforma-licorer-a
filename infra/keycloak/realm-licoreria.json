      "emailVerified": true,
      "firstName": "Gabriel",
      "lastName": "Gerente",
      "credentials": [
        {
          "type": "password",
          "value": "gerente01",
          "temporary": false
        }
      ],
      "realmRoles": [
        "GERENTE",
        "default-roles-licoreria"
      ]
    },
    {
      "username": "cajero01",
      "enabled": true,
      "email": "cajero01@licoreria.local",
      "emailVerified": true,
      "firstName": "Carla",
      "lastName": "Cajera",
      "credentials": [
        {
          "type": "password",
          "value": "cajero01",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CAJERO",
        "default-roles-licoreria"
      ]
    },
    {
      "username": "almacen01",
      "enabled": true,
      "email": "almacen01@licoreria.local",
      "emailVerified": true,
      "firstName": "Alberto",
      "lastName": "Almacén",
      "credentials": [
        {
          "type": "password",
