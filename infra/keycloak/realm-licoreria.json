        "GERENTE"
      ]
    },
    {
      "username": "service-account-ms-gestion-admin",
      "enabled": true,
      "serviceAccountClientId": "ms-gestion-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    },
    {
      "username": "service-account-ms-ventas",
      "enabled": true,
      "serviceAccountClientId": "ms-ventas",
      "realmRoles": [
        "CAJERO"
      ]
