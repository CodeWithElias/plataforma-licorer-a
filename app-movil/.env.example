# app-movil. Copiar a .env y ajustar. La app lo lee sola al arrancar: basta con "flutter run".
# Un --dart-define tiene prioridad sobre este archivo. No poner secretos: viaja dentro de la app.
#
# API_URL: dirección de Nginx en la PC donde corre docker compose.
#   Celular por USB (login incluido): http://localhost, con "adb reverse tcp:80 tcp:80"
#   Emulador Android:                 http://10.0.2.2
#   Celular por Wi-Fi:                http://<IP de la PC>; el login no vuelve mientras KC_HOSTNAME sea localhost
API_URL=http://localhost
KEYCLOAK_REALM=licoreria
KEYCLOAK_CLIENT_ID=app-movil
