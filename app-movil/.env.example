# app-movil. Copiar a .env y ajustar; se pasa al ejecutar o compilar con
#   flutter run --dart-define-from-file=.env
#
# API_URL: dirección de la PC donde corre docker compose (Nginx en el puerto 80).
#   Emulador Android: http://10.0.2.2   ·   Celular físico: http://<IP de la PC en la red local>
API_URL=http://192.168.1.10
KEYCLOAK_REALM=licoreria
KEYCLOAK_CLIENT_ID=app-movil
