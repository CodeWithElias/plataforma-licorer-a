# ms-gestion fuera de Docker (npm run start:dev). Copiar a .env y poner valores propios.
# En Docker el compose carga este mismo archivo (env_file) y solo cambia las direcciones de red.
PORT=3000
MONGO_URL=mongodb+srv://usuario:cambia-esta-clave@tu-cluster.xxxxx.mongodb.net/
MONGO_DB=gestion

# Emisor público del token y claves de Keycloak
KEYCLOAK_ISSUER=http://localhost/auth/realms/licoreria
KEYCLOAK_JWKS=http://localhost/auth/realms/licoreria/protocol/openid-connect/certs

# Cliente confidencial para crear/consultar usuarios en Keycloak (Keycloak crea el cliente con este secreto)
KEYCLOAK_ADMIN_URL=http://localhost/auth
KEYCLOAK_ADMIN_CLIENT_ID=ms-gestion-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=secreto-de-ejemplo-gestion

# Orígenes permitidos para CORS, separados por coma (vacío = sin CORS). Ejemplo: http://localhost:4201
CORS_ORIGINS=
