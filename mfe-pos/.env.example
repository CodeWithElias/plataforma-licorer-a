# mfe-pos. Copiar a .env y ajustar. Vite solo expone las variables que empiezan con VITE_ (se fijan al compilar).
# Detrás de Nginx las rutas son relativas; con npm run dev contra otro servidor, poner la URL completa.
VITE_API_VENTAS=/api/ventas
VITE_API_INVENTARIO=/api/inventario
VITE_API_IA=/api/ia
# Ejemplo apuntando a otra máquina:
# VITE_API_VENTAS=http://192.168.1.10/api/ventas
