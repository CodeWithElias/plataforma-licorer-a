# Configuración de ms-ventas. Copiar a .env y poner valores propios.
# La usan el servicio fuera de Docker (Spring la importa) y en Docker ms-ventas (env_file).
# Dentro de Docker el compose solo cambia las direcciones de red internas (KEYCLOAK_JWKS, *_URL).

# Base de datos: Supabase (Project Settings → Connect → Session pooler, puerto 5432)
POSTGRES_DB=postgres
POSTGRES_USER=postgres.referencia-del-proyecto
POSTGRES_PASSWORD=cambia-esta-clave
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
# Conexiones simultáneas a la base (el pooler gratuito de Supabase admite pocas)
DB_POOL_MAX=5

# Emisor público del token y claves de Keycloak
KEYCLOAK_ISSUER=http://localhost/auth/realms/licoreria
KEYCLOAK_JWKS=http://localhost/auth/realms/licoreria/protocol/openid-connect/certs

# Servicios que llama la Saga (fuera de Docker se llega por Nginx)
INVENTARIO_URL=http://localhost/api/inventario
GESTION_URL=http://localhost/graphql

# Orígenes permitidos para CORS, separados por coma (vacío = sin CORS). Ejemplo: http://localhost:4200
CORS_ORIGINS=
