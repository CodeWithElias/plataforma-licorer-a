# web-shell no lee variables de entorno en tiempo de ejecución (es un build estático de Angular).
# Detrás de Nginx todo va por el mismo dominio; estos son los valores que usa:
KEYCLOAK_URL=/auth
KEYCLOAK_REALM=licoreria
KEYCLOAK_CLIENT_ID=web-shell
MFE_GESTION_REMOTE_ENTRY=/mfe-gestion/remoteEntry.json
MFE_POS_ELEMENT=/mfe-pos/pos-element.js
