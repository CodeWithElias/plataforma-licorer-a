# Configuración de n8n. Copiar a .env y poner valores propios.
# La usan en Docker n8n y keycloak (que crea el cliente "n8n" con este secreto).

# Cliente de Keycloak con el que los workflows piden token (client credentials)
N8N_CLIENT_ID=n8n
N8N_CLIENT_SECRET=secreto-de-ejemplo-n8n
KEYCLOAK_TOKEN_URL=http://keycloak:8080/auth/realms/licoreria/protocol/openid-connect/token

# Permite usar estas variables en los workflows como {{ $env.N8N_CLIENT_SECRET }}
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
