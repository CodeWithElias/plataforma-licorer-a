# Configuración de n8n. Copiar a .env y poner valores propios.
# La usan en Docker n8n y keycloak (que crea el cliente "n8n" con este secreto).

# Cliente de Keycloak con el que los workflows piden token (client credentials)
N8N_CLIENT_ID=n8n
N8N_CLIENT_SECRET=secreto-de-ejemplo-n8n
KEYCLOAK_TOKEN_URL=http://keycloak:8080/auth/realms/licoreria/protocol/openid-connect/token

# Permite usar estas variables en los workflows como {{ $env.N8N_CLIENT_SECRET }}
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Servicios que llaman los workflows (directo por la red de Docker, sin pasar por Nginx)
IA_URL=http://ms-ia:8002
VENTAS_URL=http://ms-ventas:8080
GESTION_URL=http://ms-gestion:3000/graphql

# Correos (CU06 y CU07) por Gmail: SMTP_PASSWORD es una contraseña de aplicación
# (https://myaccount.google.com/apppasswords), no la contraseña de la cuenta
GERENTE_EMAIL=gerente@ejemplo.com
EMAIL_REMITENTE=Licorería <cuenta@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cuenta@gmail.com
SMTP_PASSWORD=contrasena-de-aplicacion-de-gmail

# Hora de Bolivia para el reporte diario de las 23:00
GENERIC_TIMEZONE=America/La_Paz
TZ=America/La_Paz
