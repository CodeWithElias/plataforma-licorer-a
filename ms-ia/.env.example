# ms-ia fuera de Docker. Copiar a .env y ajustar:
#   uvicorn app.main:app --reload --port 8000 --env-file .env
# En Docker el compose carga este mismo archivo (env_file) y solo cambia las direcciones de red.

# Prefijo con el que Nginx publica el servicio (vacío fuera de Docker; en Docker es /api/ia)
ROOT_PATH=

# LLM local para los agentes
OLLAMA_URL=http://localhost:11434

# Emisor público del token y claves de Keycloak
KEYCLOAK_ISSUER=http://localhost/auth/realms/licoreria
KEYCLOAK_JWKS=http://localhost/auth/realms/licoreria/protocol/openid-connect/certs

# APIs que llaman las tools MCP (fuera de Docker se llega por Nginx)
VENTAS_URL=http://localhost/api/ventas
INVENTARIO_URL=http://localhost/api/inventario
GESTION_URL=http://localhost/graphql

# Carpeta de modelos (/modelos/<versión>/ con latest.json)
MODELOS_DIR=./modelos
