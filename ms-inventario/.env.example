# ms-inventario. Copiar a .env, poner valores propios y generar la clave (o usar sh infra/crear-env.sh):
#   cp .env.example .env && php artisan key:generate
# En Docker el compose carga este mismo archivo (env_file) y solo cambia las direcciones de red.

APP_NAME=ms-inventario
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Peticiones atendidas en paralelo por el servidor de PHP
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# API sin estado: no usa base SQL ni sesiones
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# DynamoDB Local (vacío DYNAMODB_ENDPOINT = AWS real)
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=clave-de-ejemplo
AWS_SECRET_ACCESS_KEY=secreto-de-ejemplo
AWS_DEFAULT_REGION=us-east-1

# Emisor público del token y claves de Keycloak
KEYCLOAK_ISSUER=http://localhost/auth/realms/licoreria
KEYCLOAK_JWKS=http://localhost/auth/realms/licoreria/protocol/openid-connect/certs

# Orígenes permitidos para CORS, separados por coma (vacío = sin CORS). Ejemplo: http://localhost:4202
CORS_ORIGINS=

# Aviso de stock bajo (CU06)
N8N_WEBHOOK_STOCK_BAJO=http://localhost:5678/webhook/stock-bajo
